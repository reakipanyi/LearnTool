<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows7.0</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<OutputType>WinExe</OutputType>
		<Platforms>AnyCPU;x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<NoWarn>NU1510;NU1603</NoWarn>
		<BaseOutputPath>bin\</BaseOutputPath>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="Forms\Notes\**" />
	  <Compile Remove="tessdata\**" />
	  <EmbeddedResource Remove="Forms\Notes\**" />
	  <EmbeddedResource Remove="tessdata\**" />
	  <None Remove="Forms\Notes\**" />
	  <None Remove="tessdata\**" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Remove="Common\BrowserHelper.cs" />
	  <Compile Remove="Common\CacheHelper.cs" />
	  <Compile Remove="Common\Events\ContextChangedEventArgs.cs" />
	  <Compile Remove="Common\ImageHelper.cs" />
	  <Compile Remove="Common\MarkdownParser.cs" />
	  <Compile Remove="Common\WinFormsExtensions.cs" />
	  <Compile Remove="Forms\AddBookmarkDialog.cs" />
	  <Compile Remove="Forms\BaiduNetdiskAuthForm.cs" />
	  <Compile Remove="Forms\BookmarkManagerForm.cs" />
	  <Compile Remove="Forms\FormPreviewer.cs" />
	  <Compile Remove="Forms\PdfReaderForm.cs" />
	  <Compile Remove="Forms\ProgressForm.cs" />
	  <Compile Remove="Forms\UserComparisonForm.cs" />
	  <Compile Remove="Services\AI\SiliconFlowAIService.cs" />
	  <Compile Remove="Services\Cloud\BaiduPanFileManager.cs" />
	  <Compile Remove="Services\Data\LearningItemMigrationService.cs" />
	  <Compile Remove="Services\Migration\DataMigrationService.cs" />
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Remove="Forms\BaiduNetdiskAuthForm.resx" />
	  <EmbeddedResource Remove="Forms\BrowserForm.resx" />
	  <EmbeddedResource Remove="Forms\PdfReaderForm.resx" />
	  <EmbeddedResource Remove="Forms\ProgressForm.resx" />
	  <EmbeddedResource Remove="Forms\UserComparisonForm.resx" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="AppData\config\appsettings.json" />
	  <None Remove="AppData\config\SubjectTemplates.json" />
	  <None Remove="AppData\config\WebBookmarks.json" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="icon.ico" />
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Include="AppData\config\appsettings.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </EmbeddedResource>
	  <EmbeddedResource Include="AppData\config\SubjectTemplates.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </EmbeddedResource>
	  <EmbeddedResource Include="AppData\config\WebBookmarks.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="KokoroSharp" Version="0.6.7" />
		<PackageReference Include="KokoroSharp.CPU" Version="0.6.7" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2646.30" />
		<PackageReference Include="EPPlus" Version="8.6.0" />
		<PackageReference Include="EPPlus.Interfaces" Version="8.4.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
		<PackageReference Include="System.Speech" Version="10.0.8" />
		<PackageReference Include="System.Text.Json" Version="10.0.8" />
		<PackageReference Include="Tesseract" Version="5.2.0" />
		<PackageReference Include="NAudio" Version="2.3.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="SkiaSharp" Version="3.119.4" />
		<PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
		<PackageReference Include="PdfiumViewerCore" Version="1.0.0" />
		<!-- SQLite & Entity Framework Core -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
		<!-- Excel export -->
		<!-- Charting -->
		<PackageReference Include="ScottPlot.WinForms" Version="4.1.74" />
	</ItemGroup>
	<ItemGroup>
		<None Update="Data\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="Resources\WordMatchGame\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Models\Config\SubjectTemplates.json">
			<Link>AppData\config\SubjectTemplates.json</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
		<Folder Include="Data\" />
		<Folder Include="Services\Data\" />
		<Folder Include="Services\Migration\" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="Forms\UserControls\LearningProcessStatsView.cs">
	    <SubType>UserControl</SubType>
	  </Compile>
	</ItemGroup>
</Project>