<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows7.0</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<OutputType>WinExe</OutputType>
		<Platforms>AnyCPU;x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<NoWarn>NU1510;NU1603</NoWarn>
		<BaseOutputPath>bin\</BaseOutputPath>
	</PropertyGroup>
	
	<ItemGroup>
		<None Remove="AppData\config\appsettings.json" />
		<None Remove="AppData\config\SubjectTemplates.json" />
		<None Remove="AppData\config\WebBookmarks.json" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="icon.ico" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="AppData\config\appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="AppData\config\SubjectTemplates.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="AppData\config\WebBookmarks.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="KokoroSharp" Version="0.6.7" />
		<PackageReference Include="KokoroSharp.CPU" Version="0.6.7" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2646.30" />
		<PackageReference Include="EPPlus" Version="8.6.0" />
		<PackageReference Include="EPPlus.Interfaces" Version="8.4.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
		<PackageReference Include="System.Speech" Version="10.0.8" />
		<PackageReference Include="System.Text.Json" Version="10.0.8" />
		<PackageReference Include="Tesseract" Version="5.2.0" />
		<PackageReference Include="NAudio" Version="2.3.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="SkiaSharp" Version="3.119.4" />
		<PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
		<PackageReference Include="PdfiumViewerCore" Version="1.0.0" />
		<!-- SQLite & Entity Framework Core -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
		<!-- Excel export -->
		<!-- Charting -->
		<PackageReference Include="ScottPlot.WinForms" Version="4.1.74" />
	</ItemGroup>
	<ItemGroup>
		<None Update="Data\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="Resources\Shared\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="Resources\WordMatchGame\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="Resources\MemoryMatchGame\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="Resources\LinkMatchGame\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="Resources\SpellingGame\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="Resources\WhackAMoleGame\**">
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			</None>
			<None Include="Resources\SchulteGame\**">
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			</None>
			<None Include="Resources\SudokuGame\**">
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			</None>
			<None Update="Models\Config\SubjectTemplates.json">
			<Link>AppData\config\SubjectTemplates.json</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Resources\Shared\shared.css">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Resources\Shared\shared.js">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
		<Folder Include="Data\" />
		<Folder Include="Services\Data\" />
		<Folder Include="Services\Migration\" />
	</ItemGroup>
	<ItemGroup>
		<Compile Update="Forms\UserControls\LearningProcessStatsView.cs">
			<SubType>UserControl</SubType>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Forms\UserControls\LearningProcessStatsView.cs">
			<SubType>UserControl</SubType>
		</Compile>
		<Compile Update="Forms\UserControls\PanNavigatorPanel.cs">
			<SubType>UserControl</SubType>
		</Compile>
		<Compile Update="Forms\PanOrganizerForm.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="Forms\FolderRenameDialog.cs">
			<SubType>Form</SubType>
		</Compile>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\LearningAssistant.Core\LearningAssistant.Core.csproj" />
	</ItemGroup>
</Project>